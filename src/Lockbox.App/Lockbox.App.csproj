<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK version in the TFM brings in the WinRT projections used for Windows Hello. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Lockbox</AssemblyName>
    <RootNamespace>Lockbox.App</RootNamespace>
    <ApplicationIcon>Assets\Lockbox.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lockbox.Core\Lockbox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Lockbox.ico" />
  </ItemGroup>

  <!-- Self-test and screenshot tools ship in Debug builds only. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Diagnostics\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
