<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.WindowBg">#F5F5F7</Color>
    <Color x:Key="Color.Shadow">#000000</Color>

    <SolidColorBrush x:Key="Brush.WindowBg" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Brush.SidebarBg" Color="#EAEAEE" />
    <SolidColorBrush x:Key="Brush.CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#E5E5EA" />
    <SolidColorBrush x:Key="Brush.Separator" Color="#EDEDF0" />

    <SolidColorBrush x:Key="Brush.Text" Color="#1D1D1F" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6E6E73" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#A1A1A6" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#0071E3" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#0077ED" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#0065CC" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E8F1FC" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#E5352B" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#D42F26" />
    <SolidColorBrush x:Key="Brush.Success" Color="#28A745" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#C77700" />

    <SolidColorBrush x:Key="Brush.InputBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#D2D2D7" />
    <SolidColorBrush x:Key="Brush.SearchBg" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Hover" Color="#0A000000" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SecondaryButton" Color="#E8E8ED" />
    <SolidColorBrush x:Key="Brush.SecondaryButtonHover" Color="#DEDEE3" />

    <SolidColorBrush x:Key="Brush.Overlay" Color="#401D1D1F" />
    <SolidColorBrush x:Key="Brush.ToastBg" Color="#EB1D1D1F" />
    <SolidColorBrush x:Key="Brush.ToastText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#33000000" />

    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Shadow.Opacity">0.07</sys:Double>
</ResourceDictionary>
