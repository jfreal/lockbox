<UserControl x:Class="Lockbox.App.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Lockbox.App.ViewModels"
             xmlns:ui="clr-namespace:Lockbox.App.Controls">
    <DockPanel>
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="40,10,40,0" MaxWidth="820">
            <Button Style="{StaticResource Button.Plain}" HorizontalAlignment="Left" Padding="0,0,12,0" Command="{Binding BackCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="12" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Projects" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.CardBorder}" Padding="40,14">
            <Grid MaxWidth="820">
                <TextBlock Style="{StaticResource Text.Error}" Text="{Binding Error}" VerticalAlignment="Center"
                           Visibility="{Binding Error, Converter={StaticResource PresentToVisibility}}" />
                <!-- Paste step -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Open a text file…" Command="{Binding OpenFileCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Find secrets" Margin="10,0,0,0" Command="{Binding FindSecretsCommand}" />
                </StackPanel>
                <!-- Review step -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource Button.Secondary}" Content="Edit text" Command="{Binding StartOverCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding ImportButtonText}" Margin="10,0,0,0" Command="{Binding ImportCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <!-- ===== Step 1: paste ===== -->
            <DockPanel MaxWidth="820" Margin="40,14,40,24"
                       Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Text.LargeTitle}" Text="Import from text" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="1,6,0,0" MaxWidth="640" HorizontalAlignment="Left"
                               Text="Paste your notes or open a text file. Lockbox reads them on this PC and suggests what to save. Nothing is saved until you press Import." />
                </StackPanel>
                <TextBox Style="{StaticResource Input.Multiline}" Margin="0,22,0,0" Tag="Paste here…" ui:Assist.FocusOnLoad="True"
                         Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}" ui:Assist.CornerRadius="14" />
            </DockPanel>

            <!-- ===== Step 2: review ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}">
                <StackPanel MaxWidth="820" Margin="40,14,40,32">
                    <TextBlock Style="{StaticResource Text.LargeTitle}" Text="Review" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="1,6,0,0"
                               Text="{Binding Summary, StringFormat='{}{0} Untick anything you don’t want. Rename projects to match yours.'}" />

                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ImportGroupViewModel}">
                                <StackPanel Margin="0,22,0,0">
                                    <Grid Margin="2,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{DynamicResource Brush.Accent}" />
                                        <TextBox Grid.Column="1" Style="{StaticResource Input}" MinHeight="36" Margin="10,0,0,0" FontWeight="SemiBold"
                                                 Tag="Project name" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Footnote}" Text="{Binding Destination}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                    <Border Style="{StaticResource Card}" Padding="0,4">
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ImportItemViewModel}">
                                                    <Grid>
                                                        <Border x:Name="Separator" Height="1" VerticalAlignment="Top" Margin="50,0,0,0" Background="{DynamicResource Brush.Separator}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource DividerVisibility}">
                            <Binding />
                            <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                            <Binding Path="ItemsSource.Count" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                        </MultiBinding>
                    </Border.Visibility>
                </Border>
                                                        <Grid Margin="16,8,12,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="260" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1" Style="{StaticResource Input.Inline}" Margin="10,0,0,0" FontWeight="SemiBold"
                                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock x:Name="Value" Grid.Column="2" Style="{StaticResource Text.Mono}" Text="{Binding DisplayValue}" Margin="14,0,8,0"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Content="{Binding RevealGlyph}" Command="{Binding ToggleRevealCommand}" ToolTip="Show or hide" />
                                                        </Grid>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                            <Setter TargetName="Value" Property="Opacity" Value="0.45" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRevealed}" Value="True">
                                                            <Setter TargetName="Value" Property="TextWrapping" Value="Wrap" />
                                                            <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Lines that didn't look like secrets -->
                    <Border Style="{StaticResource Card}" Margin="0,30,0,0" Padding="20,18"
                            Visibility="{Binding HasLeftovers, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" ToolTip="Show or hide"
                                        Content="{Binding LeftoverGlyph}" Command="{Binding ToggleLeftoversCommand}" />
                                <TextBlock Style="{StaticResource Text.Headline}" VerticalAlignment="Center"
                                           Text="{Binding LeftoverTitle}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"
                                       Text="Lines that didn't look like a name and a value. Keep them as one note so nothing gets lost." />
                            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="10" Background="{DynamicResource Brush.WindowBg}"
                                    Visibility="{Binding RevealLeftovers, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Leftovers}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <CheckBox Style="{StaticResource Check}" Content="Save them as a note in" IsChecked="{Binding SaveLeftovers}" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource Input}" MinHeight="34" Width="220" Margin="10,0,0,0" Tag="Project name"
                                         Text="{Binding LeftoverProjectName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
