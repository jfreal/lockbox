<UserControl x:Class="Lockbox.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lockbox.App.Controls">
    <Grid>
        <!-- Step 1: passphrase -->
        <StackPanel Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40"
                    Visibility="{Binding IsHelloStep, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <Border Width="72" Height="72" CornerRadius="22" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="30" Foreground="#FFFFFF" />
            </Border>
            <TextBlock Style="{StaticResource Text.LargeTitle}" Text="Welcome to Lockbox" HorizontalAlignment="Center" Margin="0,26,0,0" />
            <TextBlock Style="{StaticResource Text.Secondary}" TextAlignment="Center" Margin="12,10,12,0"
                       Text="Your secrets stay encrypted on this PC. Choose a passphrase to protect them." />

            <PasswordBox Style="{StaticResource Input.Password}" Tag="Passphrase" Margin="0,30,0,0" ui:Assist.FocusOnLoad="True"
                         ui:PasswordBoxAssist.Password="{Binding Passphrase, UpdateSourceTrigger=PropertyChanged}" />
            <PasswordBox Style="{StaticResource Input.Password}" Tag="Type it again" Margin="0,10,0,0"
                         ui:PasswordBoxAssist.Password="{Binding Confirm, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="2,14,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="6" /><ColumnDefinition /><ColumnDefinition Width="6" /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="4" CornerRadius="2" Background="{DynamicResource Brush.Accent}" Opacity="{Binding StrengthLevel, Converter={StaticResource StrengthSegmentOpacity}, ConverterParameter=1}" />
                <Border Grid.Column="2" Height="4" CornerRadius="2" Background="{DynamicResource Brush.Accent}" Opacity="{Binding StrengthLevel, Converter={StaticResource StrengthSegmentOpacity}, ConverterParameter=2}" />
                <Border Grid.Column="4" Height="4" CornerRadius="2" Background="{DynamicResource Brush.Accent}" Opacity="{Binding StrengthLevel, Converter={StaticResource StrengthSegmentOpacity}, ConverterParameter=3}" />
            </Grid>
            <TextBlock Style="{StaticResource Text.Footnote}" Text="{Binding StrengthText}" Margin="2,8,2,0" />

            <TextBlock Style="{StaticResource Text.Error}" Text="{Binding Error}" Margin="2,12,2,0"
                       Visibility="{Binding Error, Converter={StaticResource PresentToVisibility}}" />

            <Button Style="{StaticResource Button.Primary}" Content="Create vault" Margin="0,22,0,0" Height="42" ui:Assist.CornerRadius="21"
                    Command="{Binding CreateCommand}" IsDefault="True" />
            <Button Style="{StaticResource Button.Plain}" Content="Restore from a backup…" Margin="0,8,0,0" HorizontalAlignment="Center"
                    Command="{Binding RestoreCommand}" />

            <TextBlock Style="{StaticResource Text.Footnote}" TextAlignment="Center" Margin="20,22,20,0"
                       Text="Nobody can recover this passphrase, including you if you forget it. Write it down somewhere safe and offline." />
        </StackPanel>

        <!-- Step 2: Windows Hello -->
        <StackPanel Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40"
                    Visibility="{Binding IsHelloStep, Converter={StaticResource BoolToVisibility}}">
            <Border Width="72" Height="72" CornerRadius="22" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE928;" FontSize="32" Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <TextBlock Style="{StaticResource Text.LargeTitle}" Text="Unlock with Windows Hello?" HorizontalAlignment="Center" Margin="0,26,0,0" />
            <TextBlock Style="{StaticResource Text.Secondary}" TextAlignment="Center" Margin="12,10,12,0"
                       Text="Use your PIN, face, or fingerprint instead of typing your passphrase. Your passphrase still works, and you need it to restore from a backup." />
            <TextBlock Style="{StaticResource Text.Error}" Text="{Binding Error}" TextAlignment="Center" Margin="2,14,2,0"
                       Visibility="{Binding Error, Converter={StaticResource PresentToVisibility}}" />
            <Button Style="{StaticResource Button.Primary}" Content="{Binding HelloButtonText}" Margin="0,28,0,0" Height="42" ui:Assist.CornerRadius="21"
                    Command="{Binding EnableHelloCommand}" IsDefault="True" />
            <Button Style="{StaticResource Button.Plain}" Content="Not now" Margin="0,8,0,0" HorizontalAlignment="Center"
                    Command="{Binding SkipHelloCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
