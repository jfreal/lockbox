<UserControl x:Class="Lockbox.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Headline}">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="20,15" />
        </Style>
        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="20,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Separator}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="20,30,0,8" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="40,10,40,0" MaxWidth="680">
            <Button Style="{StaticResource Button.Plain}" HorizontalAlignment="Left" Padding="0,0,12,0" Command="{Binding BackCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="12" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Projects" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel MaxWidth="680" Margin="40,14,40,48">
                <TextBlock Style="{StaticResource Text.LargeTitle}" Text="Settings" />

                <!-- Security -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Security" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Windows Hello" />
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding HelloDetail}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="{Binding HelloButtonText}" VerticalAlignment="Center"
                                    Command="{Binding ToggleHelloCommand}" IsEnabled="{Binding HelloAvailable}" />
                        </Grid>
                        <Border Style="{StaticResource RowSeparator}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Passphrase" />
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding PassphraseDetail}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Change…" VerticalAlignment="Center" Command="{Binding ChangePassphraseCommand}" />
                        </Grid>
                        <Border Style="{StaticResource RowSeparator}" />
                        <Grid Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Auto-lock" />
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding AutoLockDetail}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Backup -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Backup" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Backup folder" />
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding BackupFolder}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE8B7;" ToolTip="Show in File Explorer" Command="{Binding ShowBackupFolderCommand}" />
                                <Button Style="{StaticResource Button.Secondary}" Content="Change…" Margin="8,0,0,0" Command="{Binding ChooseBackupFolderCommand}" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource RowSeparator}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Automatic backups" />
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,3,0,0"
                                           Text="{Binding LastBackupDetail, StringFormat='{}Every change is copied here, still encrypted. One copy per day is kept for 10 days. {0}'}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Back up now" VerticalAlignment="Center" Command="{Binding BackUpNowCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- About -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="This PC" />
                <Border Style="{StaticResource Card}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Vault file" />
                            <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding VaultPath}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Content="&#xE8B7;" ToolTip="Show in File Explorer" VerticalAlignment="Center" Command="{Binding ShowVaultFileCommand}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource Text.Footnote}" Margin="20,18,0,0"
                           Text="{Binding Version, StringFormat='{}Lockbox {0}. Encrypted with AES-256-GCM. Passphrase key from Argon2id. No network access.'}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
