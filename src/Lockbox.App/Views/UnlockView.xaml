<UserControl x:Class="Lockbox.App.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lockbox.App.Controls">
    <StackPanel Width="360" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60">
        <Border Width="72" Height="72" CornerRadius="22" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="30" Foreground="#FFFFFF" />
        </Border>
        <TextBlock Style="{StaticResource Text.LargeTitle}" Text="Lockbox is locked" HorizontalAlignment="Center" Margin="0,26,0,0" />
        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Subtitle}" TextAlignment="Center" Margin="8,10,8,0" />

        <!-- Windows Hello -->
        <StackPanel Visibility="{Binding UsePassphrase, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <Button Style="{StaticResource Button.Primary}" Margin="0,32,0,0" Height="44" ui:Assist.CornerRadius="22"
                    Command="{Binding UnlockWithHelloCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE928;" FontSize="16" Foreground="#FFFFFF" />
                    <TextBlock Text="{Binding HelloButtonText}" Margin="10,0,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Button.Plain}" Content="Use passphrase instead" Margin="0,10,0,0" HorizontalAlignment="Center"
                    Command="{Binding TogglePassphraseCommand}" />
        </StackPanel>

        <!-- Passphrase -->
        <StackPanel Visibility="{Binding UsePassphrase, Converter={StaticResource BoolToVisibility}}">
            <PasswordBox Style="{StaticResource Input.Password}" Tag="Passphrase" Margin="0,30,0,0" ui:Assist.FocusOnLoad="True"
                         ui:PasswordBoxAssist.Password="{Binding Passphrase, UpdateSourceTrigger=PropertyChanged}" />
            <Button Style="{StaticResource Button.Primary}" Margin="0,14,0,0" Height="44" ui:Assist.CornerRadius="22"
                    Command="{Binding UnlockWithPassphraseCommand}" IsDefault="True">
                <Grid>
                    <TextBlock Text="Unlock" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBlock Text="Unlocking…" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Button>
            <Button Style="{StaticResource Button.Plain}" Content="Use Windows Hello instead" Margin="0,10,0,0" HorizontalAlignment="Center"
                    Command="{Binding TogglePassphraseCommand}"
                    Visibility="{Binding CanUseHello, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Text.Error}" Text="{Binding Error}" TextAlignment="Center" Margin="0,16,0,0"
                   Visibility="{Binding Error, Converter={StaticResource PresentToVisibility}}" />
    </StackPanel>
</UserControl>
